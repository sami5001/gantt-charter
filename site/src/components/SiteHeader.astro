---
import HeaderActions from './HeaderActions';

interface Props {
  current: 'guide' | 'about';
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (active: boolean) =>
  `rounded-md px-2 py-1 text-[13px] transition-colors duration-150 hover:bg-line-soft hover:text-ink-950 ${
    active ? 'font-medium text-ink-950' : 'text-ink-500'
  }`;
---

<header class="sticky top-0 z-10 flex h-14 items-center justify-between border-b border-line bg-surface px-4">
  <a href={`${base}/`} class="flex items-center gap-2.5">
    <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
      <rect x="2" y="4" width="12" height="3.5" rx="1.25" fill="var(--color-ink-950)"></rect>
      <rect x="6" y="9.25" width="14" height="3.5" rx="1.25" fill="var(--color-accent)"></rect>
      <rect x="3.5" y="14.5" width="9" height="3.5" rx="1.25" fill="var(--color-ink-300)"></rect>
    </svg>
    <span class="text-[15px] font-semibold tracking-tight text-ink-950">Gantt Charter</span>
  </a>
  <div class="flex items-center gap-1">
    <nav class="mr-1 flex items-center gap-0.5">
      <a href={`${base}/`} class={link(false)}>App</a>
      <a href={`${base}/guide/`} class={link(current === 'guide')}>Guide</a>
      <a href={`${base}/about/`} class={link(current === 'about')}>About</a>
    </nav>
    <HeaderActions client:load />
  </div>
</header>
